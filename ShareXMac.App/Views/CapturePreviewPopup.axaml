<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShareXMac.App.ViewModels"
        x:Class="ShareXMac.App.Views.CapturePreviewPopup"
        x:DataType="vm:CapturePreviewViewModel"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Width="280" Height="80">

    <Border Background="#2E2E2E" CornerRadius="8"
            BorderBrush="#404040" BorderThickness="1"
            BoxShadow="0 4 16 #40000000"
            Padding="8">
        <Grid ColumnDefinitions="60,*,Auto" RowDefinitions="*,4">
            <!-- Thumbnail -->
            <Image Grid.Column="0" Grid.Row="0"
                   Source="{Binding ThumbnailBitmap}"
                   Width="60" Height="60"
                   Stretch="Uniform" />

            <!-- Action buttons -->
            <StackPanel Grid.Column="2" Grid.Row="0"
                        Orientation="Vertical" Spacing="4"
                        VerticalAlignment="Center">
                <Button Command="{Binding CopyCommand}"
                        Width="32" Height="32" Padding="0"
                        ToolTip.Tip="Copy to Clipboard"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="C" />
                <Button Command="{Binding SaveCommand}"
                        Width="32" Height="32" Padding="0"
                        ToolTip.Tip="Show in Finder"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="S" />
                <Button Command="{Binding OpenCommand}"
                        Width="32" Height="32" Padding="0"
                        ToolTip.Tip="Open in Editor"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="O" />
            </StackPanel>

            <!-- Progress bar (auto-dismiss countdown) -->
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                         Value="{Binding ProgressPercent}" Maximum="100"
                         Height="4" Margin="0,4,0,0"
                         Foreground="#3E83F2" Background="#404040" />
        </Grid>
    </Border>
</Window>
