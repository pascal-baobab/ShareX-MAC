<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareXMac.App.ViewModels"
             x:Class="ShareXMac.App.Views.HistoryItemCard"
             x:DataType="vm:HistoryItemViewModel">

    <Border Background="#FDFDFD" CornerRadius="8"
            BorderBrush="#E0E0E0" BorderThickness="1"
            Padding="8" Margin="4">

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Copy to Clipboard" />
                <MenuItem Header="Show in Finder" />
                <Separator />
                <MenuItem Header="Delete" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Spacing="4">
            <!-- Thumbnail 100x100 -->
            <Image Width="100" Height="100"
                   Stretch="Uniform"
                   Source="{Binding ThumbnailBitmap}" />

            <!-- Filename (13px SemiBold, truncate with ellipsis) -->
            <TextBlock Text="{Binding DisplayFilename}"
                       FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="140" />

            <!-- Date + mode badge -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding DisplayDate}"
                           FontSize="11" Foreground="#999999" />
                <Border Background="#3E83F2" CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="{Binding Mode}"
                               FontSize="11" Foreground="White" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
