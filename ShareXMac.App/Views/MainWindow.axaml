<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ShareXMac.App.Views"
        x:Class="ShareXMac.App.Views.MainWindow"
        Title="ShareXMac"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="180" Background="#F5F5F5"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="16" Spacing="8">
                <TextBlock Text="ShareXMac" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="Capture History" FontWeight="SemiBold"
                           Cursor="Hand" />
                <TextBlock Text="Settings" Foreground="#999999" />
            </StackPanel>
        </Border>

        <!-- Main content area hosting HistoryView -->
        <views:HistoryView DataContext="{Binding History}" />
    </DockPanel>

</Window>
